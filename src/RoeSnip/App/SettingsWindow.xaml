<Window x:Class="RoeSnip.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoeSnip Settings"
        Icon="pack://application:,,,/Assets/roesnip.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF000000"
        Foreground="#FFEDEDF0"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Theme/RoeSnipTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Window-local: drives the Advanced body's Visibility off the header ToggleButton's
                 IsChecked with no code-behind needed (see the Grid near the bottom of this file). -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- No MaxHeight here: the window itself is clamped to the work area in code-behind, so the
             content decides the height and this only starts scrolling on a screen too short to show
             it all. A fixed pixel cap hid the Sharing section on a 1440p desktop with room to spare.
             The window title bar already reads "RoeSnip Settings", so no in-window title repeats it. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,16,18,4">
                <!-- Capture -->
                <TextBlock Text="Capture" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Hotkey" Foreground="{StaticResource RlTextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HotkeyDisplay" Grid.Column="0" IsReadOnly="True"
                                     Style="{StaticResource ReadOnlyHotkeyBoxStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="ChangeHotkeyButton" Grid.Column="1" Content="Change..." Click="ChangeHotkeyButton_Click"/>
                        </Grid>

                        <Border Height="1" Margin="0,12" Background="{StaticResource RlBorderBrush}"/>

                        <TextBlock Text="Save directory" Foreground="{StaticResource RlTextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SaveDirectoryBox" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="BrowseButton_Click"/>
                        </Grid>

                        <Border Height="1" Margin="0,12" Background="{StaticResource RlBorderBrush}"/>

                        <CheckBox x:Name="AutoSaveHdrCheckBox" Content="Save HDR copy" Margin="0,0,0,4"/>
                        <TextBlock Text="Keep the untouched FP16 .jxr next to the PNG."
                                   Margin="20,0,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource RlTextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <TextBlock Text="Behavior" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="CopyOnSelectCheckBox" Content="Copy to clipboard on selection" Margin="0,0,0,4"/>
                        <TextBlock Text="Confirming a selection also copies it, no extra step needed."
                                   Margin="20,0,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource RlTextMutedBrush}"/>

                        <Border Height="1" Margin="0,12" Background="{StaticResource RlBorderBrush}"/>

                        <CheckBox x:Name="ColorPickerCheckBox" Content="Colour picker" Margin="0,0,0,4"/>
                        <TextBlock Text="Click to sample a colour, with a magnified loupe and colour codes."
                                   Margin="20,0,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource RlTextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Startup -->
                <TextBlock Text="Startup" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="RunAtStartupCheckBox" Content="Start RoeSnip at login" Margin="0,0,0,4"/>
                        <TextBlock x:Name="RunAtStartupHintText" Margin="20,0,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource RlTextMutedBrush}" Visibility="Collapsed"/>

                        <Border Height="1" Margin="0,12" Background="{StaticResource RlBorderBrush}"/>

                        <StackPanel x:Name="ElevatedStartupSection">
                            <CheckBox x:Name="RunElevatedCheckBox" Content="Run as administrator" Margin="0,0,0,4"
                                      Checked="RunElevatedCheckBox_Checked" Unchecked="RunElevatedCheckBox_Unchecked"/>
                            <TextBlock Text="Persists through a scheduled task. No UAC prompt at every launch."
                                       Margin="20,0,0,4" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource RlTextMutedBrush}"/>
                            <TextBlock x:Name="ElevationStatusText" Margin="20,0,0,0" FontSize="11"
                                       Foreground="{StaticResource RlTextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <TextBlock Text="Check for updates" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <ComboBox x:Name="UpdateFrequencyCombo" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="UpdateFrequencyHintText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource RlTextMutedBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Advanced (collapsed by default, sits outside any card) -->
                <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource ExpanderHeaderToggleStyle}">
                    <StackPanel>
                        <TextBlock Text="Advanced" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource RlTextPrimaryBrush}"/>
                        <TextBlock Text="Tone-map overrides. Leave blank for automatic." Margin="0,2,0,0"
                                   FontSize="11" Foreground="{StaticResource RlTextDimBrush}"/>
                    </StackPanel>
                </ToggleButton>
                <Grid x:Name="AdvancedBody" Margin="10,10,10,0"
                      Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Knee (0-1)" Foreground="{StaticResource RlTextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="KneeOverrideBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Peak" Foreground="{StaticResource RlTextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="PeakOverrideBox"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Margin="0,16" Background="{StaticResource RlBorderStrongBrush}"/>

                <!-- Sharing -->
                <TextBlock Text="Sharing" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Default share provider" Foreground="{StaticResource RlTextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DefaultShareProviderCombo" Grid.Column="0" Margin="0,0,8,0"
                                      DisplayMemberPath="Name" SelectionChanged="DefaultShareProviderCombo_SelectionChanged"/>
                            <Button x:Name="ManageProvidersButton" Grid.Column="1" Content="Providers..." Click="ManageProvidersButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource RlBgElevatedBrush}"
                BorderBrush="{StaticResource RlBorderStrongBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12,18,14">
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
