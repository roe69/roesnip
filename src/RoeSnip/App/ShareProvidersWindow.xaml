<Window x:Class="RoeSnip.App.ShareProvidersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sharing providers"
        Icon="pack://application:,,,/Assets/roesnip.ico"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF000000"
        Foreground="#FFEDEDF0"
        FontFamily="Segoe UI"
        FontSize="13">
    <!-- Dark control chrome (Button/CheckBox/ComboBox/etc.) now comes from the shared
         Theme/RoeSnipTheme.xaml dictionary - the same one SettingsWindow.xaml merges - instead of
         this window's own plain-property-setter styles, which is what left the ComboBox/Button/
         CheckBox chrome light regardless of the Background/Foreground values set here. The legacy
         "MutedBrush"/"PanelBrush"/"BorderBrush2" keys this file's code-behind looks up via
         Resources["..."] are still defined (as aliases onto the real Rl* tokens) inside that merged
         dictionary, so nothing in ShareProvidersWindow.xaml.cs needed to change to keep resolving
         them. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Theme/RoeSnipTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Sharing providers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Every provider below is just a web request (endpoint, headers, and how to find the returned URL) - built-ins are pre-filled, 'Custom...' lets you point RoeSnip at any compatible upload API of your own."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddCustomButton" Content="Custom..." Click="AddCustomButton_Click" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProvidersListPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
