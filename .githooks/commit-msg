#!/bin/sh
# Blocks commit messages that credit an AI (Co-Authored-By: Claude, "Generated
# with Claude Code", noreply@anthropic.com) or carry AI tells / mangled text
# (em dashes, curly quotes, emoji, mojibake ...). Commit messages reach players.
# Escape hatch: ALLOW_UNICODE=1 (typography only).
# Enable once per clone:  git config core.hooksPath .githooks
trap "" PIPE   # keep going (and reach exit 1) even if whoever reads our stderr goes away
. "$(dirname "$0")/ai-tells.sh"
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
grep -v '^[[:space:]]*#' "$1" > "$tmp"
out=$(scan_ai_tells "$tmp")
if [ -n "$out" ]; then
  echo "commit-msg hook: AI tells in commit message:" >&2
  echo "$out" >&2
  echo "Plain ASCII, no AI co-author / generated-with lines. Fix the message and retry." >&2
  [ -z "$AI_TELLS_MODE" ] && echo "(ALLOW_UNICODE=1 relaxes typography only; AI credit lines are always blocked)" >&2
  exit 1
fi
exit 0
